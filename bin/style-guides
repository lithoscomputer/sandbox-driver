#!/bin/sh
set -eu

SCRIPT_ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(dirname -- "$SCRIPT_ROOT")
LOCK_FILE="$REPOSITORY_ROOT/.ai/style-guides.lock"
STYLE_GUIDES_ROOT="$REPOSITORY_ROOT/.ai/style-guides"
DEFAULT_DEVELOPMENT_ROOT="$REPOSITORY_ROOT/../../brynary"
DEVELOPMENT_ROOT=${RUST_STYLE_GUIDES_ROOT:-"$DEFAULT_DEVELOPMENT_ROOT"}

case "$DEVELOPMENT_ROOT" in
  /*) ;;
  *) DEVELOPMENT_ROOT="$PWD/$DEVELOPMENT_ROOT" ;;
esac

usage() {
  echo "Usage: bin/style-guides prepare" >&2
  exit 2
}

fail() {
  echo "style-guides: $*" >&2
  exit 1
}

origin_matches() {
  repository_root=$1
  public_url=$2
  repository_slug=${public_url#https://github.com/}
  repository_slug=${repository_slug%.git}
  origin_url=$(git -C "$repository_root" remote get-url origin 2>/dev/null) ||
    return 1

  case "$origin_url" in
    "https://github.com/$repository_slug" | \
      "https://github.com/$repository_slug.git" | \
      "git@github.com:$repository_slug" | \
      "git@github.com:$repository_slug.git" | \
      "ssh://git@github.com/$repository_slug" | \
      "ssh://git@github.com/$repository_slug.git")
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

guide_is_ready() {
  repository_root=$1
  revision=$2
  public_url=$3

  [ -d "$repository_root" ] &&
    [ -r "$repository_root/SKILL.md" ] &&
    git -C "$repository_root" rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
    [ "$(git -C "$repository_root" rev-parse HEAD 2>/dev/null)" = "$revision" ] &&
    [ -z "$(git -C "$repository_root" status --porcelain 2>/dev/null)" ] &&
    origin_matches "$repository_root" "$public_url"
}

refresh_managed_checkout() {
  repository_root=$1
  revision=$2
  public_url=$3

  origin_matches "$repository_root" "$public_url" ||
    fail "$repository_root has an unexpected origin; refusing to modify it"
  [ -z "$(git -C "$repository_root" status --porcelain 2>/dev/null)" ] ||
    fail "$repository_root has local changes; refusing to modify it"

  git -C "$repository_root" fetch --quiet --prune origin \
    '+refs/heads/*:refs/remotes/origin/*' ||
    fail "could not fetch $public_url"
  git -C "$repository_root" cat-file -e "$revision^{commit}" 2>/dev/null ||
    fail "$revision is not available from $public_url"
  git -C "$repository_root" checkout --quiet --detach "$revision" ||
    fail "could not check out $revision in $repository_root"
}

clone_guide() {
  name=$1
  revision=$2
  public_url=$3
  destination=$4
  temporary_root=$(mktemp -d "$STYLE_GUIDES_ROOT/.${name}.XXXXXX")

  (
    trap 'rm -rf "$temporary_root"' EXIT HUP INT TERM

    git clone --quiet --filter=blob:none --no-tags \
      "$public_url" "$temporary_root/repository" ||
      fail "could not clone $public_url"
    git -C "$temporary_root/repository" checkout --quiet --detach "$revision" ||
      fail "could not check out $revision from $public_url"
    guide_is_ready "$temporary_root/repository" "$revision" "$public_url" ||
      fail "the cloned $name checkout failed validation"
    mv "$temporary_root/repository" "$destination"
  )
}

prepare_guide() {
  name=$1
  revision=$2
  public_url=$3
  destination="$STYLE_GUIDES_ROOT/$name"
  development_checkout="$DEVELOPMENT_ROOT/$name"

  if guide_is_ready "$destination" "$revision" "$public_url"; then
    echo "$name: ready at $destination ($revision)"
    return
  fi

  if [ -L "$destination" ]; then
    rm "$destination"
  elif [ -e "$destination" ]; then
    git -C "$destination" rev-parse --is-inside-work-tree >/dev/null 2>&1 ||
      fail "$destination exists but is not a Git checkout"
    refresh_managed_checkout "$destination" "$revision" "$public_url"
    guide_is_ready "$destination" "$revision" "$public_url" ||
      fail "the refreshed $name checkout failed validation"
    echo "$name: refreshed at $destination ($revision)"
    return
  fi

  if guide_is_ready "$development_checkout" "$revision" "$public_url"; then
    ln -s "$development_checkout" "$destination"
    echo "$name: linked from $development_checkout ($revision)"
    return
  fi

  clone_guide "$name" "$revision" "$public_url" "$destination"
  echo "$name: cloned at $destination ($revision)"
}

[ "${1:-}" = "prepare" ] || usage
[ "$#" -eq 1 ] || usage
command -v git >/dev/null 2>&1 || fail "Git is required"
[ -r "$LOCK_FILE" ] || fail "missing lock file: $LOCK_FILE"

mkdir -p "$STYLE_GUIDES_ROOT"

guide_count=0
while read -r name revision public_url extra; do
  case "$name" in
    '' | \#*)
      continue
      ;;
  esac

  [ -z "${extra:-}" ] || fail "invalid lock entry for $name"
  [ "$name" = "rust-style-guide" ] || fail "unexpected guide: $name"
  [ "${#revision}" -eq 40 ] || fail "invalid revision for $name: $revision"
  case "$revision" in
    *[!0123456789abcdef]*) fail "invalid revision for $name: $revision" ;;
  esac
  case "$public_url" in
    https://github.com/*.git) ;;
    *) fail "invalid public clone URL for $name: $public_url" ;;
  esac

  prepare_guide "$name" "$revision" "$public_url"
  guide_count=$((guide_count + 1))
done < "$LOCK_FILE"

[ "$guide_count" -eq 1 ] || fail "expected exactly one style guide"

echo
echo "Read this entry point before Rust work:"
echo "  $STYLE_GUIDES_ROOT/rust-style-guide/SKILL.md"
