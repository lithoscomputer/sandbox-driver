#!/bin/sh
# Regenerates sandbox-driver-boxd's gRPC code from the api.proto that
# boxd publishes, keeping only the calls the provider makes. Records the
# source and its SHA-256 beside the generated code. Review the diff: a
# changed message is a changed contract with boxd.
set -eu

source_url="https://docs.boxd.sh/reference/grpc-proto.md"
root=$(cd "$(dirname "$0")/.." && pwd)
out="$root/crates/sandbox-driver-boxd/src/runtime/api"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

curl -fsSL "$source_url" -o "$work/page.md"
# The page holds the proto as its first fenced code block.
awk '/^```/{n++; next} n==1' "$work/page.md" > "$work/api.proto"
grep -q '^package boxd.api.v1;' "$work/api.proto"

cargo run --quiet --locked --manifest-path "$root/tools/boxd-api/Cargo.toml" -- \
  "$work/api.proto" "$out"
cargo +nightly-2026-04-14 fmt --manifest-path "$root/Cargo.toml" -p sandbox-driver-boxd

sha=$(shasum -a 256 "$work/api.proto" | cut -d' ' -f1)
cat > "$out/SOURCE" <<SOURCE
Generated by bin/boxd-api from the boxd public API definition.
Source:    $source_url
Retrieved: $(date -u +%Y-%m-%d)
SHA-256:   $sha
SOURCE
echo "regenerated $out from $sha"
